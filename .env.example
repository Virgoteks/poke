# Copy to .env and fill in real values. Never commit .env.
# All secrets are read from the environment only (see src/config/env.ts).

NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- PostgreSQL (system of record) ---
DATABASE_URL=postgres://outreach:outreach_dev_pw@localhost:5432/outreach_dev
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- Redis (idempotency locks, rate limiting, queues) ---
REDIS_URL=redis://localhost:6379

# --- Shared webhook / API auth ---
INTERNAL_API_KEY=dev-internal-api-key-change-me
INSTANTLY_WEBHOOK_SECRET=dev-instantly-webhook-secret-change-me
CALENDLY_WEBHOOK_SECRET=dev-calendly-webhook-secret-change-me

# --- Google ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# --- Apollo ---
APOLLO_API_KEY=

# --- Email verification provider ---
EMAIL_VERIFICATION_API_KEY=
EMAIL_VERIFICATION_PROVIDER=neverbounce

# --- Instantly ---
INSTANTLY_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Calendly ---
CALENDLY_API_KEY=
CALENDLY_ORG_URI=
CALENDLY_EVENT_TYPE_URI=

# --- Feature flags / safety ---
MOCK_EXTERNAL_APIS=true
DRY_RUN_SENDING=true
SAFETY_SUPPRESSION_WINDOW_HOURS=24
SAFETY_MAX_SUPPRESSIONS_PER_WINDOW=10
