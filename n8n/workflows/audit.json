{
  "name": "AUDIT - website crawl + PageSpeed",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] }
      },
      "id": "cron-trigger",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.CORE_API_BASE_URL}}/audit/pending?limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-internal-api-key", "value": "={{$env.INTERNAL_API_KEY}}" }]
        },
        "options": { "timeout": 15000 }
      },
      "id": "fetch-pending",
      "name": "GET /audit/pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": { "fieldToSplitOut": "companies", "options": {} },
      "id": "split-companies",
      "name": "Split companies",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CORE_API_BASE_URL}}/audit/website",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-api-key", "value": "={{$env.INTERNAL_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"companyId\": $json.id } }}",
        "options": { "timeout": 60000 }
      },
      "id": "call-audit",
      "name": "POST /audit/website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Hourly": { "main": [[{ "node": "GET /audit/pending", "type": "main", "index": 0 }]] },
    "GET /audit/pending": { "main": [[{ "node": "Split companies", "type": "main", "index": 0 }]] },
    "Split companies": { "main": [[{ "node": "POST /audit/website", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
