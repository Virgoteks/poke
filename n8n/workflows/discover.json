{
  "name": "DISCOVER - Google Places business discovery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "query", "value": "={{$env.DISCOVERY_QUERY || \"HVAC contractors in Orlando FL\"}}" }
          ]
        },
        "options": {}
      },
      "id": "set-query",
      "name": "Set discovery query",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CORE_API_BASE_URL}}/discover/places",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-api-key", "value": "={{$env.INTERNAL_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"query\": $json.query, \"maxResults\": 20 } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-discover",
      "name": "POST /discover/places",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [[{ "node": "Set discovery query", "type": "main", "index": 0 }]]
    },
    "Set discovery query": {
      "main": [[{ "node": "POST /discover/places", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
