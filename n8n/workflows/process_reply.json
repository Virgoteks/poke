{
  "name": "PROCESS REPLY - Instantly reply webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "instantly-reply",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Instantly reply webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "instantly-reply"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CORE_API_BASE_URL}}/webhooks/instantly/reply",
