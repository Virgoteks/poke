{
  "name": "VERIFY - email verification",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } },
      "id": "cron-trigger",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.CORE_API_BASE_URL}}/verify/pending?limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-internal-api-key", "value": "={{$env.INTERNAL_API_KEY}}" }]
        },
        "options": { "timeout": 15000 }
      },
      "id": "fetch-pending",
      "name": "GET /verify/pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": { "fieldToSplitOut": "contacts", "options": {} },
      "id": "split-contacts",
      "name": "Split contacts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CORE_API_BASE_URL}}/verify/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-internal-api-key", "value": "={{$env.INTERNAL_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"contactId\": $json.id } }}",
        "options": { "timeout": 30000 }
      },
      "id": "call-verify",
      "name": "POST /verify/email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Hourly": { "main": [[{ "node": "GET /verify/pending", "type": "main", "index": 0 }]] },
    "GET /verify/pending": { "main": [[{ "node": "Split contacts", "type": "main", "index": 0 }]] },
    "Split contacts": { "main": [[{ "node": "POST /verify/email", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
